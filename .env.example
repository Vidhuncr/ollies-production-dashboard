# Copy this file to .env for local use. Never publish or commit .env.
# Leave blank for local SQLite. For shared data, paste the Supabase Session Pooler
# connection string from Project > Connect and replace [YOUR-PASSWORD].
SUPABASE_DATABASE_URL=
APP_USERNAME=admin
APP_ADMIN_EMAIL=admin@your-company.com
APP_PASSWORD=choose-a-long-unique-password
PLANT_TIMEZONE=America/Chicago
DB_POOL_MAX=8
MAX_REQUEST_THREADS=32
DASHBOARD_CACHE_TTL=1.5
EMAIL_ENABLED=true
EMAIL_PROVIDER=gmail_smtp
GMAIL_ADDRESS=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
